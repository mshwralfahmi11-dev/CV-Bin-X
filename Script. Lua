-- 1. فحص البلوك تحت اللاعب لمعرفة الحلبة الحالية
local function getArenaUnderPlayer(root)
    local arenas = workspace:FindFirstChild("Arenas")
    if not arenas or not root then return nil end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Include
    rayParams.FilterDescendantsInstances = {arenas}

    local hit = workspace:Raycast(root.Position, Vector3.new(0, -30, 0), rayParams)
    if hit and hit.Instance then
        for _, arena in ipairs(arenas:GetChildren()) do
            if hit.Instance:IsDescendantOf(arena) then
                return arena
            end
        end
    end

    local myPos = root.Position
    for _, arena in ipairs(arenas:GetChildren()) do
        local map = arena:FindFirstChild("Map")
        local floor = (map and map:FindFirstChild("Floor")) or arena:FindFirstChild("Floor") or arena:FindFirstChild("Teleport") or arena:FindFirstChild("Block")
        if floor and floor:IsA("BasePart") and (myPos - floor.Position).Magnitude < 130 then
            return arena
        end
    end

    return nil
end

-- 2. معرفة جهة اللاعب في الحلبة
local function getPlayerSlotSide(arena, player)
    if not arena or not player then return nil end
    local slots = arena:FindFirstChild("Slots")
    if not slots then return nil end

    local left = slots:FindFirstChild("Left")
    local right = slots:FindFirstChild("Right")

    if left and left:FindFirstChild(player.Name, true) then return "Left" end
    if right and right:FindFirstChild(player.Name, true) then return "Right" end

    if left then
        for _, item in ipairs(left:GetDescendants()) do
            if (item:IsA("StringValue") or item:IsA("ObjectValue")) and (item.Value == player.Name or item.Value == player) then
                return "Left"
            end
        end
    end

    if right then
        for _, item in ipairs(right:GetDescendants()) do
            if (item:IsA("StringValue") or item:IsA("ObjectValue")) and (item.Value == player.Name or item.Value == player) then
                return "Right"
            end
        end
    end

    return nil
end

-- 3. فحص الشعاع لمنع المرور عبر الجدران المغلقة أو الشفافة
local function isBlockedByWallOrGlass(originPos, targetPos)
    local dir = targetPos - originPos
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local ignoreList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(ignoreList, p.Character)
        end
    end
    rayParams.FilterDescendantsInstances = ignoreList

    local hit = workspace:Raycast(originPos, dir, rayParams)
    if hit and hit.Instance then
        local inst = hit.Instance
        local name = string.lower(inst.Name)
        if inst.CanCollide or name:find("barrier") or name:find("glass") or name:find("wall") or name:find("block") or name:find("brick") then
            return true
        end
    end
    return false
end

-- 4. حلقة تحديث الخصوم والفرق كل ثانية واحدة لمنع أي قلتش أو تعليق
local CurrentOpponentsList = {}

task.spawn(function()
    while true do
        pcall(function()
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local newOpponents = {}

            if myRoot then
                local currentArena = getArenaUnderPlayer(myRoot)
                if currentArena then
                    local mySide = getPlayerSlotSide(currentArena, LocalPlayer)
                    local myPos = myRoot.Position

                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local oppChar = p.Character
                            local oppRoot = oppChar:FindFirstChild("HumanoidRootPart")
                            local oppHum = oppChar:FindFirstChildOfClass("Humanoid")

                            if oppRoot and oppHum and oppHum.Health > 0 and oppHum:GetState() ~= Enum.HumanoidStateType.Dead then
                                local oppArena = getArenaUnderPlayer(oppRoot)
                                
                                if oppArena == currentArena or (oppRoot.Position - myPos).Magnitude < 130 then
                                    local oppSide = getPlayerSlotSide(currentArena, p)

                                    local isOpponent = false
                                    if mySide and oppSide then
                                        isOpponent = (mySide ~= oppSide) -- يتجاهل تماماً من بنفس جهتك
                                    elseif currentArena.Name == "FFA" or not mySide then
                                        isOpponent = true
                                    end

                                    if isOpponent then
                                        table.insert(newOpponents, oppChar)
                                    end
                                end
                            end
                        end
                    end
                end
            end

            CurrentOpponentsList = newOpponents
        end)
        task.wait(1.0) -- تحديث هادئ كل ثانية
    end
end)

-- جلب أقرب ضحية متاحة بدون جدار عازل
local function getClosestValidVictim(myPos)
    local closestVictim = nil
    local minDist = 99999

    for _, oppChar in ipairs(CurrentOpponentsList) do
        if oppChar and oppChar.Parent then
            local oppRoot = oppChar:FindFirstChild("HumanoidRootPart")
            local oppHum = oppChar:FindFirstChildOfClass("Humanoid")

            if oppRoot and oppHum and oppHum.Health > 0 and oppHum:GetState() ~= Enum.HumanoidStateType.Dead then
                local dist = (myPos - oppRoot.Position).Magnitude
                if dist < minDist then
                    -- فحص الشعاع فقط على الهدف الأقرب
                    if not isBlockedByWallOrGlass(myPos, oppRoot.Position) then
                        minDist = dist
                        closestVictim = oppChar
                    end
                end
            end
        end
    end

    return closestVictim
end

