-- Auto Pass Bomb (الالتصاق اللحظي بالخصم حتى تسليم القنبلة والعودة لمكانك)
local isPassing = false
task.spawn(function()
    while true do
        task.wait(0.04)
        if getgenv().CVBin.AutoPass and not isPassing and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if root then
                local bombObj, contactPart = checkHasBomb(char)
                
                if bombObj and contactPart then
                    local targetVictim = getClosestValidVictim(root.Position)
                    
                    if targetVictim then
                        isPassing = true
                        local originalCFrame = root.CFrame
                        local vicRoot = targetVictim:FindFirstChild("HumanoidRootPart")
                        local vicHum = targetVictim:FindFirstChildOfClass("Humanoid")

                        local latchStart = tick()
                        while (tick() - latchStart < 1.0) and vicRoot and vicHum and vicHum.Health > 0 and vicHum:GetState() ~= Enum.HumanoidStateType.Dead and checkHasBomb(char) do
                            root.CFrame = vicRoot.CFrame * CFrame.new(0, 0, 1.2)
                            fireTouch(contactPart, vicRoot)
                            task.wait(0.02)
                        end

                        root.CFrame = originalCFrame
                        task.wait(0.15)
                        isPassing = false
                    end
                end
            end
        end
    end
end)

-- Auto Chase
local lastTouchTime = 0
RunService.Heartbeat:Connect(function(dt)
    if getgenv().CVBin.AutoChase and getgenv().CVBin.AutoActive and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end
        
        local bombObj, contactPart = checkHasBomb(char)
        if not bombObj then return end

        local targetVictim = getClosestValidVictim(root.Position)
        
        if targetVictim then
            local vicRoot = targetVictim:FindFirstChild("HumanoidRootPart")
            if vicRoot then
                local targetPos = vicRoot.Position
                local dist = (root.Position - targetPos).Magnitude
                
                if dist > 20 then
                    humanoid:MoveTo(targetPos)
                    humanoid.WalkSpeed = getgenv().CVBin.Speed1Enabled and getgenv().CVBin.Speed1Value or 24
                elseif dist > 3 then
                    humanoid:MoveTo(targetPos)
                    local behindPos = vicRoot.CFrame * CFrame.new(0, 0, 1.5)
                    root.CFrame = root.CFrame:Lerp(behindPos, 0.2)
                else
                    if tick() - lastTouchTime > 0.08 then
                        lastTouchTime = tick()
                        local touchPart = contactPart or root
                        fireTouch(touchPart, vicRoot)
                    end
                end
            end
        end
    end
end)

-- Zoom in Hitbox
local HitboxSphere = nil
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char.HumanoidRootPart
    
    if getgenv().CVBin.ZoomHitbox then
        if not HitboxSphere or HitboxSphere.Parent ~= char then
            if HitboxSphere then HitboxSphere:Destroy() end
            
            HitboxSphere = Instance.new("Part")
            HitboxSphere.Name = "CVBinHitboxSphere"
            HitboxSphere.Shape = Enum.PartType.Ball
            HitboxSphere.Material = Enum.Material.Glass
            HitboxSphere.Color = Color3.fromRGB(0, 240, 255)
            HitboxSphere.Transparency = 0.82
            HitboxSphere.CanCollide = false
            HitboxSphere.Massless = true
            HitboxSphere.CastShadow = false
            HitboxSphere.CFrame = root.CFrame
            HitboxSphere.Parent = char
            
            local weld = Instance.new("Weld")
            weld.Part0 = root
            weld.Part1 = HitboxSphere
            weld.C0 = CFrame.new()
            weld.C1 = CFrame.new()
            weld.Parent = HitboxSphere
        end
        
        local rad = tonumber(getgenv().CVBin.HitboxRadius) or 25
        HitboxSphere.Size = Vector3.new(rad * 2, rad * 2, rad * 2)
        
        for _, vicChar in ipairs(CurrentOpponentsList) do
            if vicChar and vicChar.Parent then
                local otherRoot = vicChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (root.Position - otherRoot.Position).Magnitude
                    if dist <= rad then
                        local _, contactPart = checkHasBomb(char)
                        local bombPart = contactPart or root
                        fireTouch(bombPart, otherRoot)
                    end
                end
            end
        end
    else
        if HitboxSphere then
            HitboxSphere:Destroy()
            HitboxSphere = nil
        end
    end
end)

